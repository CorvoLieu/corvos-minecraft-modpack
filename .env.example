# Name of the modpack/instance. This is the single value to change to rename
# the whole pack: it drives the manifest filename (manifest/<PACK_NAME>.json),
# DATAPACK_WORLD_NAME in build_mrpack.py, the default SKLauncher instance
# name, the default world/level name (docker-compose.dev.yml), the default
# pack display name baked into built .mrpack files, and the local
# `make build-image` tag. Everything below is an optional override on top of
# this default -- unset, they all fall back to PACK_NAME.
PACK_NAME=minecraft-modded

# Path to your local SKLauncher instance directory, used by push_instance.py
# and pull_instance.py. Copy this file to .env and fill in your own path.
# Not needed on macOS if you're using the default install location and an
# instance name that matches PACK_NAME.
SK_INSTANCE_DIR=/path/to/sklauncher/instances/minecraft-modded

# If SK_INSTANCE_DIR isn't set, the OS default SKLauncher instances dir is
# used with this instance name (macOS: ~/Library/Application
# Support/sklauncher/instances/<INSTANCE_NAME>). Only needed if your local
# instance name differs from PACK_NAME above.
# INSTANCE_NAME=minecraft-modded

# --- Deploy-time overrides for docker-compose.prod.yml ---
# Anything left unset falls back to the value baked into the Dockerfile.
# .env is gitignored -- don't commit real values here.

# GHCR image path used by docker-compose.stg.yml / docker-compose.prod.yml.
# Defaults to this repo's own GHCR package; override if you've forked/renamed
# the repo and publish images somewhere else.
# IMAGE_NAME=ghcr.io/corvolieu/mc-creark-modpack

# VERSION / NEOFORGE_VERSION are tied to what the baked-in modpack was built
# against. Only change these if you're also shipping a matching image.
VERSION=1.21.1
NEOFORGE_VERSION=21.1.233

MEMORY=15360M
# Used by docker-compose.prod.yml/stg.yml only (falls back to "world" if
# unset there); docker-compose.dev.yml derives its world name from PACK_NAME
# above instead.
LEVEL=minecraft-modded
DIFFICULTY=normal
MODE=survival
ONLINE_MODE=false
FORCE_GAMEMODE=true
ENABLE_AUTOPAUSE=true
ENTITY_BROADCAST_RANGE_PERCENTAGE=70
SIMULATION_DISTANCE=7
VIEW_DISTANCE=7
ALLOW_FLIGHT=true

OPS=CakeBoy

# Multi-command values are \n-separated (not real newlines).
RCON_CMDS_STARTUP=/gamerule playersSleepingPercentage 0\n/gamerule mobGriefing false
RCON_CMDS_ON_CONNECT=/recipe give @p *
