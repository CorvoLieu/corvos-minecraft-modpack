# Deploy-time overrides for docker-compose.prod.yml. Copy to .env and edit
# as needed; anything left unset falls back to the value baked into the
# Dockerfile. .env is gitignored -- don't commit real values here.

# VERSION / NEOFORGE_VERSION are tied to what the baked-in modpack was built
# against. Only change these if you're also shipping a matching image.
VERSION=1.21.1
NEOFORGE_VERSION=21.1.233

MEMORY=15360M
LEVEL=creark
DIFFICULTY=normal
MODE=survival
ONLINE_MODE=false
FORCE_GAMEMODE=true
ENABLE_AUTOPAUSE=true
ENTITY_BROADCAST_RANGE_PERCENTAGE=70
SIMULATION_DISTANCE=7
VIEW_DISTANCE=7
ALLOW_FLIGHT=true

OPS=CakeBoy

# Multi-command values are \n-separated (not real newlines).
RCON_CMDS_STARTUP=/gamerule playersSleepingPercentage 0\n/gamerule mobGriefing false
RCON_CMDS_ON_CONNECT=/recipe give @p *
