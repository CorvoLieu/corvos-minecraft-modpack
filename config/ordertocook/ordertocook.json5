{
	// ========== Order Machine / Levels ==========
// Max number of Order Machines allowed within 24 blocks (Default: 1)
// 
	"maxOrderMachinesWithin24": 1,
	// Order Machine refresh cooldown in seconds (Default: 600)
	"orderMachineRefreshSeconds": 600,
	// Walk-in customer spawn attempt interval in seconds (Default: 60)
	"walkInAttemptIntervalSeconds": 60,
	// Order Machine upgrade requirement: Sum of board menu hunger within 24 blocks.
// Index = requirement for that level; Lv.0 is always 0.
// Default: [0,40,80,120,160,200,300,400,600]
// 
	"orderMachineUpgradeBoardHunger": [0,40,80,120,160,200,300,400,600],
	// Walk-in customer chance (0.0 - 1.0) - Lv.1
	"walkInChanceLevel1": 0.0,
	// Walk-in customer chance (0.0 - 1.0) - Lv.2
	"walkInChanceLevel2": 0.0,
	// Walk-in customer chance (0.0 - 1.0) - Lv.3
	"walkInChanceLevel3": 0.1,
	// Walk-in customer chance (0.0 - 1.0) - Lv.4
	"walkInChanceLevel4": 0.15,
	// Walk-in customer chance (0.0 - 1.0) - Lv.5
	"walkInChanceLevel5": 0.2,
	// Walk-in customer chance (0.0 - 1.0) - Lv.6
	"walkInChanceLevel6": 0.25,
	// Walk-in customer chance (0.0 - 1.0) - Lv.7
	"walkInChanceLevel7": 0.3,
	// Walk-in customer chance (0.0 - 1.0) - Lv.8
	"walkInChanceLevel8": 0.35,
	// ========== Order Generation ==========
// Order weight (percent) - White
// 
	"weightWhite": 50,
	// Order weight (percent) - Green
	"weightGreen": 25,
	// Order weight (percent) - Blue
	"weightBlue": 15,
	// Order weight (percent) - Purple
	"weightPurple": 8,
	// Order weight (percent) - Red (rarest)
	"weightRed": 2,
	// Chance to generate Delivery orders (0.0 - 1.0)
	"deliveryRate": 0.3,
	// Chance to generate Urgent orders (0.0 - 1.0)
	"urgentRate": 0.1,
	// Chance to replace Delivery with Long-distance Delivery (0.0 - 1.0)
	"longDistanceDeliveryChance": 0.1,
	// ========== Rewards / Currency ==========
// Custom reward item ID (e.g. minecraft:emerald). If empty, oTc coins are used.
// 
	"customCurrencyItem": "",
	// Base oTc coin rewards per order tier [White, Green, Blue, Purple, Red]
	"defaultCoinArray": [1,2,3,4,6],
	// Extra oTc coins for completing urgent orders (added on top of base)
	"rushBonus": 3,
	// Delivery reward multiplier (e.g. 1.8 means +80%)
	"deliveryMultiplier": 1.8,
	// Long-distance delivery reward multiplier (Default: 4.0)
	"longDistanceDeliveryMultiplier": 4.0,
	// ========== NPC / Tips ==========
// Normal customer probability (0.0 - 1.0), Default: 0.9
// 
	"normalCustomerRate": 0.9,
	// Textured NPC gender ratio: female customer proportion (0.0 - 1.0), Default: 0.5; others are male
	"customerFemaleRate": 0.5,
	// Enable multiple resource-pack customer skins. If true, normal customers use textures/entity/customs/custom_wide_x.png and custom_slim_x.png, with x starting at 1 and continuous. Easter egg player skins are unaffected.
	"customMultipleCustomerSkins": false,
	// Easter egg customer probability (0.0 - 1.0), Default: 0.1
	"easterEggCustomerRate": 0.1,
	// Tip chance for normal orders (0.0 - 1.0)
	"tipNormalChance": 0.1,
	// Tip chance for urgent orders (0.0 - 1.0)
	"tipUrgentChance": 0.5,
	// Tip chance for easter egg customers (0.0 - 1.0)
	"tipEasterEggCustomerChance": 1.0,
	// Tip random range: min value
	"tipMin": 1,
	// Tip random range: max value
	"tipMax": 3,
	// Rainy day tip random range: min value
	"rainTipMin": 3,
	// Rainy day tip random range: max value
	"rainTipMax": 5,
	// ========== Debug ==========
// Enable dev mode debug chat messages (Default: false)
// 
	"devMode": false,
	// ========== Countertop / Packaging ==========
// Whether crafting takeout bags consumes leather from shelf (Default: true=consume)
// 
	"countertopConsumeLeather": true,
	// ========== Compatibility ==========
// Enable SDMShop / SDM Economy digital currency. Uses the configured SDM currency key instead of physical oTc coins.
// 
	"sdmShopCurrencyCompat": false,
	// SDM Economy currency key used when SDMShop currency compatibility is enabled.
	"sdmShopCurrencyKey": "basic_money",
	// Enable Touhou Little Maid customer compatibility. Normal customers use Touhou Little Maid entities when the mod is installed. Easter egg customers keep OrderToCook's own customer model.
	"touhouLittleMaidCustomerCompat": false,
	// ========== Names Language ==========
// Customer name list language: zh_cn or en_us
// 
	"namesLanguage": "zh_cn"
}